# Ignore all raw archives and SQLite databases
*.sqlite3*
*.tar.gz
*.tar
golden_reference.*

# Ignore live secrets and config files
.env
*.env
rclone.conf
*.conf
*.key
*.pem
data/

# Allow sanitized templates, scripts, and logs
!rclone.conf.example
!vaultwarden-backup.sh
!vaultwarden-verify-audit.sh
!Logs/
!README.md
docker-compose.yml
.env.example
